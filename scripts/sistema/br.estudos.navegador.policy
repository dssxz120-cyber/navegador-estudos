<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Regra do polkit para o modo protegido do Navegador de Estudos.
  Instalada pela Etapa 2 em /usr/share/polkit-1/actions/.
  Qualquer pessoa (inclusive o aluno) só consegue salvar a configuração
  digitando a senha de um ADMINISTRADOR do Ubuntu (auth_admin), sempre,
  sem lembrar a autorização por alguns minutos.
-->
<policyconfig>
  <vendor>Navegador de Estudos</vendor>
  <action id="br.estudos.navegador.salvar-configuracao">
    <description>Salvar a lista de sites do Navegador de Estudos</description>
    <message>Para alterar os sites permitidos, digite a senha de administrador.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/navegador-estudos/scripts/salvar-configuracao</annotate>
  </action>
</policyconfig>
